{
  "functions": {
    "api/sitemap.ts": {
      "includeFiles": "src/data/**"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!api/|sitemap\\.xml$|robots\\.txt$|ads\\.txt$).*)",
      "destination": "/index.html"
    }
  ]
}
