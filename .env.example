# Resend API Key (from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# The email address that receives contact form inquiries
CONTACT_RECEIVER_EMAIL=rishithagorupati@gmail.com

# The verified sender address in Resend.
# During initial testing (before domain verification), use: onboarding@resend.dev
# After verifying your custom domain in Resend, use: Rishitha Gorupati <hello@rishithagoripati.com> or contact@rishithagoripati.com
CONTACT_SENDER_EMAIL=onboarding@resend.dev

# Author Portal Server-Side Passkey (required in Vercel production)
ADMIN_PASSKEY=your_secret_author_passkey

# Optional dedicated HMAC signing secret for admin sessions (defaults to ADMIN_PASSKEY if omitted)
# ADMIN_SESSION_SECRET=long_random_secret_string

# GitHub Personal Access Token for permanent journal publishing from /admin
# Fine-grained PAT: Repository -> Rushindra-D/personal-website -> Permissions -> Contents: Read and write
GITHUB_TOKEN=github_pat_your_token_here

# Optional GitHub repository overrides (defaults shown below)
# GITHUB_OWNER=Rushindra-D
# GITHUB_REPO=personal-website
# GITHUB_BRANCH=main
